rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid}/products/{productId} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /coverages/{coverageId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
